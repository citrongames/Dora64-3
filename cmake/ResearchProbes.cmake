find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
set(DORA3_GENERATED_DIR "${CMAKE_SOURCE_DIR}/build-local/boot" CACHE PATH "Output of generate_boot.py")
set(DORA3_RECOMP_INCLUDE "${CMAKE_SOURCE_DIR}/build-tools/n64recomp/source/include" CACHE PATH "Pinned N64Recomp headers")
set(DORA3_PROBE_KIND "boot" CACHE STRING "boot or decoder")
if(NOT DORA3_PROBE_KIND MATCHES "^(boot|decoder)$")
    message(FATAL_ERROR "DORA3_PROBE_KIND must be boot or decoder")
endif()
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/tools/verify_generation.py" "${DORA3_GENERATED_DIR}"
    RESULT_VARIABLE receipt_result OUTPUT_VARIABLE receipt_output ERROR_VARIABLE receipt_error)
if(NOT receipt_result EQUAL 0)
    message(FATAL_ERROR "Generate verified boot code first. ${receipt_output}${receipt_error}")
endif()
file(READ "${DORA3_GENERATED_DIR}/generation-receipt.json" receipt)
string(JSON receipt_input_count LENGTH "${receipt}" inputs)
math(EXPR receipt_input_last "${receipt_input_count}-1")
foreach(i RANGE 0 ${receipt_input_last})
    string(JSON input_name MEMBER "${receipt}" inputs ${i})
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/${input_name}")
endforeach()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${DORA3_GENERATED_DIR}/generation-receipt.json")
file(GLOB boot_sources CONFIGURE_DEPENDS "${DORA3_GENERATED_DIR}/RecompiledFuncs/*.c")
set(probe_target "dora3_${DORA3_PROBE_KIND}_probe")
add_executable(${probe_target} "src/${DORA3_PROBE_KIND}_probe.c" ${boot_sources})
set_property(TARGET ${probe_target} PROPERTY C_STANDARD 17)
target_include_directories(${probe_target} PRIVATE "${CMAKE_SOURCE_DIR}/src" "${DORA3_RECOMP_INCLUDE}" "${DORA3_GENERATED_DIR}/RecompiledFuncs")
if(NOT MSVC)
    target_compile_options(${probe_target} PRIVATE -fno-strict-aliasing)
endif()
