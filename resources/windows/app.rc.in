#include <windows.h>
1 ICON "@ROOT@/assets/icons/dora64-3.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "citrongames"
   VALUE "FileDescription", "Dora64-3"
   VALUE "FileVersion", "@PROJECT_VERSION@"
   VALUE "InternalName", "Dora64-3"
   VALUE "LegalCopyright", "Copyright (c) 2026 citrongames"
   VALUE "OriginalFilename", "Dora64-3.exe"
   VALUE "ProductName", "Dora64-3"
   VALUE "ProductVersion", "@PROJECT_VERSION@"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
